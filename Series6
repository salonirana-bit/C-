#include <iostream>
#include <string>
using namespace std;

int main() {
    string str = "Hello";
    
    for (int i = 0; i < str.length(); i++) {
        if (str[i] == 'z') {
            str[i] = 'a';
        } else if (str[i] == 'Z') {
            str[i] = 'A';
        } else if ((str[i] >= 'a' && str[i] < 'z') || (str[i] >= 'A' && str[i] < 'Z')) {
            str[i] = str[i] + 1; // Shifts to the next character
        }
    }
    
    cout << "Modified string: " << str << endl;
    return 0;
}
